VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Edge Function secret (set via `supabase secrets set ...`, not in .env)
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Phase 2 — Parent Loop. Server-side keys (api/*.js, scripts/*.mjs); never
# exposed to the client except VITE_STRIPE_PUBLISHABLE_KEY, which is safe
# to expose (it's a publishable key by design).
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# Stripe — TEST MODE keys only during Phase 2. Do not put live-mode keys
# here; flipping to live mode is a Sal-only action post-verification.
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_TEST_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_TEST_WEBHOOK_SECRET"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_TEST_PUBLISHABLE_KEY"
# Created by scripts/create-stripe-products.mjs — not secrets (price IDs
# are safe to expose), but server-side only since the client just sends
# an interval ('month'|'year') and the server resolves the price ID.
STRIPE_PRICE_FAMILY_MONTHLY="price_YOUR_MONTHLY_PRICE_ID"
STRIPE_PRICE_FAMILY_YEARLY="price_YOUR_YEARLY_PRICE_ID"

